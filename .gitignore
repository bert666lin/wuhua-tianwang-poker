# 依赖
node_modules/
*/node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo
.tmp/

# 运行时日志
.runtime-logs/
*.log

# 截图 / 审计产物（体积大，可随时重新生成；也会出现在 client/ 下）
_shots/
_audit/
*/_shots/
*/_audit/
*.png
!client/public/*.png
!android/app/src/main/res/**/*.png

# 打包快照
*.tar.gz

# 设计源文件和历史压缩包不进 Git；请用网盘/对象存储/Git LFS 单独保存。
*.psd
*.zip

# 编辑器与系统
.DS_Store
.vscode/
.idea/
.worktrees/

# 备份文件（改用 git 历史，不要再留 .bak）
*.bak
*.bak[0-9]

# 本地开发 HTTPS 自签证书（每台机器自己生成，含本机局域网 IP，不入库）
# 生成方式: bash scripts/gen-dev-cert.sh
client/.cert/
*.pem
client/.env.production
client/.env.local

# 临时排查脚本（AI 行为探针等，一次性用完即弃，不进版本库）
server/.probe/

# 运行时数据库（账号 / 金币 / 战绩），线上数据不入库，部署时保留
server/data/
*.db
*.db-shm
*.db-wal

# Android 本地构建与签名（绝不能入库）
android/local.properties
android/keystore.properties
android/app/keystore/
*.jks
*.keystore
releases/

android/local-maven/
