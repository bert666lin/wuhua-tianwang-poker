{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "DEV_HTTPS=1 vite",
    "cert": "bash ../scripts/gen-dev-cert.sh",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify": "npm run lint && npm run typecheck && npm test",
    "visual:check": "node scripts/visual-regression.mjs",
    "smoke:critical": "node scripts/critical-flow-smoke.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
